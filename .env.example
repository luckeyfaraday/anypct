# Never commit credentials. PowerShell: $env:BENCH_API_KEY = '...'
BENCH_API_KEY=
BENCH_BASE_URL=https://openrouter.ai/api/v1
BENCH_MODEL=
# Neutral-harness profiles (profiles.example.json) read these instead.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# Optional executable override (Java 17 is suitable for this pinned server).
BENCH_JAVA=java
